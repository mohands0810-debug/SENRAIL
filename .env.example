# Environment Variables — Example
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# =============================================================
# SENRAIL — Environment Configuration
# =============================================================

# Future: Railway Data Feed
# VITE_RAILWAY_API_BASE_URL=https://api.example-railway-feed.in/v1
# VITE_RAILWAY_API_KEY=your-api-key-here

# Future: Weather Service
# VITE_WEATHER_API_BASE_URL=https://api.example-weather.in/v1
# VITE_WEATHER_API_KEY=your-api-key-here

# Future: Backend API
# VITE_BACKEND_BASE_URL=http://localhost:8080/api

# =============================================================
# No environment variables are required for the prototype.
# The application runs entirely in the browser using simulated data.
# =============================================================
